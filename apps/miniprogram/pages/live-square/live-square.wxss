.page-live-square {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 头部 */
.square-header {
  position: relative;
  background: linear-gradient(135deg, #e8a838, #f5c96a);
  padding: 30rpx 30rpx 40rpx;
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  top: 26rpx;
  left: 24rpx;
  z-index: 10;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn image {
  width: 36rpx;
  height: 36rpx;
}

.square-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.square-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

/* 数据概览 */
.square-stats {
  display: flex;
  margin: -20rpx 24rpx 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(232,168,56,0.12);
  position: relative;
  z-index: 5;
}

.square-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.square-stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #e8a838;
}

.square-stat-label {
  font-size: 22rpx;
  color: #999999;
}

/* 动态列表 */
.square-posts {
  padding: 0 24rpx;
}

.feed-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.feed-user {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.feed-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.feed-user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.feed-user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.feed-time {
  font-size: 22rpx;
  color: #bbbbbb;
}

.feed-content {
  margin-bottom: 14rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.feed-media {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 14rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.feed-img {
  width: calc((100% - 12rpx) / 3);
  height: 210rpx;
}

.feed-img-single {
  width: 100%;
  height: 400rpx;
}

/* 第3张图上的 +N 遮罩 */
.feed-more-mask {
  position: absolute;
  right: 0;
  bottom: 0;
  width: calc((100% - 12rpx) / 3);
  height: 210rpx;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 6rpx 0;
}
.feed-more-text {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.feed-video {
  width: 100%;
  height: 400rpx;
  position: relative;
  margin-bottom: 14rpx;
}

.feed-video-cover {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
}

.feed-actions {
  display: flex;
  align-items: center;
  gap: 40rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.feed-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #999999;
}

.feed-action image {
  width: 32rpx;
  height: 32rpx;
}
