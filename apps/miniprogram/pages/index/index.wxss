/* ============================================================
   首页 · 今日活动 — UI/UX 优化版
   大理游客视角：沉浸式头部 · 增强卡片 · 微动画
   ============================================================ */
.page-index {
  min-height: 100vh;
  background: var(--bg-page);
}

/* ── 沉浸式头部 ── */
.index-hero {
  position: relative;
  flex-shrink: 0;
  background: linear-gradient(165deg, var(--color-brand-dark) 0%, var(--color-brand) 45%, var(--color-brand-light) 80%, var(--color-brand-hero-end) 100%);
  padding: 0 var(--space-lg) 20rpx;
  overflow: hidden;
}
.hero-pattern {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.05);
}
.hero-pattern::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -60rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
}

/* 主标题 */
.slogan-main {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
  line-height: 1.2;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
  position: relative;
  z-index: 1;
}

/* 副标题（紧贴主标题） */
.slogan-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  letter-spacing: 1rpx;
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}
.slogan-num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-warm-light);
  margin: 0 6rpx;
}

/* 底部行：区域选择 + 活动日历（同行，底部对齐） */
.hero-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 22rpx;
  position: relative;
  z-index: 1;
}
.hero-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 定位栏 */
.hero-location {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: rgba(255,255,255,0.12);
  border-radius: var(--radius-full);
  backdrop-filter: blur(4rpx);
  flex-shrink: 0;
}
.loc-icon-img { width: 26rpx; height: 26rpx; }
.loc-text  { font-size: 28rpx; color: #fff; font-weight: 600; }
.loc-arrow { width: 20rpx; height: 20rpx; margin-left: 2rpx; }

/* 活动日历按钮 */
.hero-action {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  background: rgba(255,255,255,0.15);
  border-radius: var(--radius-full);
  color: #fff;
  font-size: var(--text-sm);
  font-weight: 500;
  backdrop-filter: blur(4rpx);
  flex-shrink: 0;
  position: relative;
  z-index: 2;
  transition: all var(--duration-fast) var(--ease-out);
}
.hero-action:active {
  background: rgba(255,255,255,0.3);
  transform: scale(0.95);
}
.action-icon-img { width: 28rpx; height: 28rpx; }
/* 主题切换按钮（仅图标） */
.hero-theme-btn {
  padding: 14rpx 20rpx;
}

/* ── 日历面板 ── */
.calendar-wrap {
  max-height: 0;
  overflow: hidden;
  flex-shrink: 0;
  transition: max-height var(--duration-normal) var(--ease-out);
}
.calendar-wrap.calendar-open {
  max-height: 800rpx;
}
.calendar-panel {
  background: var(--bg-surface);
  margin: 0 var(--space-md);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--shadow-md);
}
.cal-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.cal-nav-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.cal-nav-btn-img {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.cal-nav-btn {
  width: 52rpx; height: 52rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--bg-page);
  border-radius: 50%;
  font-size: 22rpx;
  color: var(--text-secondary);
}
.cal-nav-btn:active { background: var(--border-base); }
.cal-month-label {
  font-size: var(--text-md);
  font-weight: 700;
  color: var(--text-title);
  min-width: 160rpx;
  text-align: center;
}
.cal-today-btn {
  padding: 10rpx 24rpx;
  background: var(--color-brand);
  color: #fff;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 600;
}
/* 星期行 */
.cal-week-row {
  display: flex;
  margin-bottom: 8rpx;
}
.cal-week-cell {
  flex: 1;
  text-align: center;
  font-size: var(--text-xs);
  color: var(--text-hint);
  padding: 8rpx 0;
}
/* 日期网格 */
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  width: calc(100% / 7);
  min-height: 72rpx;
  box-sizing: border-box;
  padding: 2rpx;
}
.cal-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 2rpx;
  border-radius: var(--radius-xs);
  transition: background var(--duration-fast);
}
.cal-today .cal-inner {
  background: var(--color-brand-bg);
}
.cal-day {
  font-size: 26rpx;
  color: var(--text-body);
  font-weight: 500;
  line-height: 1.4;
}
.cal-today .cal-day {
  background: var(--color-brand);
  color: #fff;
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700;
}
/* 活动彩色圆点 */
.cal-dots {
  display: flex;
  gap: 4rpx;
  margin-top: 4rpx;
  flex-wrap: wrap;
  justify-content: center;
}
.cal-dot {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ── 搜索栏 ── */
.idx-search {
  display: flex;
  align-items: center;
  background: var(--bg-surface);
  margin: var(--space-md) var(--space-lg);
  padding: 16rpx 24rpx;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-xs);
  border: 2rpx solid transparent;
  transition: border-color var(--duration-fast);
}
.idx-search:active { border-color: var(--color-brand); }
.idx-search-icon-img {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}
.idx-search-text {
  flex: 1;
  font-size: var(--text-sm);
  color: var(--text-hint);
}

/* ── 分类 Tab ── */
.idx-tabs {
  display: flex;
  padding: 0 var(--space-lg) var(--space-md);
  white-space: nowrap;
}
.idx-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  color: var(--text-secondary);
  background: var(--bg-surface);
  margin-right: 12rpx;
  flex-shrink: 0;
  transition: all var(--duration-fast) var(--ease-out);
  box-shadow: var(--shadow-xs);
}
.idx-tab.tab-on {
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-light));
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(var(--color-brand-rgb), 0.22);
}
.idx-tab:active { transform: scale(0.95); }
.tab-icon-img { width: 26rpx; height: 26rpx; margin-right: 4rpx; }

/* ── 排序条 ── */
.idx-sort {
  display: flex;
  align-items: center;
  padding: 10rpx var(--space-lg) 16rpx;
  gap: 24rpx;
}
.sort-item {
  font-size: var(--text-sm);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 0;
  transition: color var(--duration-fast);
  border-bottom: 3rpx solid transparent;
}
.sort-item.sort-on {
  color: var(--color-brand);
  font-weight: 600;
  border-bottom-color: var(--color-brand);
}
.sort-free { margin-left: auto; }

/* ── 活动列表 ── */
.idx-list {
  padding: 0 var(--space-md);
}

/* ── 活动卡片（全新设计） ── */
.act-card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--space-lg);
  box-shadow: var(--shadow-sm);
  transition: transform var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out);
}
.card-press {
  transform: scale(0.98);
  box-shadow: var(--shadow-xs);
}

/* 封面 */
.act-cover {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
}
.act-cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s var(--ease-out);
}
.act-card:active .act-cover-img {
  transform: scale(1.05);
}
.act-cover-gradient {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 80rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.25));
  pointer-events: none;
}

/* 价格标签 */
.act-price-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-xs);
  font-size: var(--text-xs);
  font-weight: 600;
  color: #fff;
  backdrop-filter: blur(8rpx);
}
.price-free   { background: rgba(39,174,96,0.85); }
.price-charge { background: rgba(232,168,56,0.85); }

/* 爆火角标 */
.act-hot-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-xs);
  font-size: var(--text-xs);
  font-weight: 600;
  color: #fff;
  background: rgba(231,76,60,0.85);
  animation: pulse 2s ease-in-out infinite;
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.hot-badge-icon { width: 22rpx; height: 22rpx; }

/* 剩余名额 */
.act-remain {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(231,76,60,0.9);
  color: #fff;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  font-size: var(--text-2xs);
  font-weight: 600;
}

/* 约满蒙层 */
.act-soldout {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.act-soldout text {
  padding: 12rpx 36rpx;
  background: rgba(255,255,255,0.2);
  border-radius: var(--radius-sm);
  color: #fff;
  font-size: var(--text-base);
  font-weight: 700;
  letter-spacing: 4rpx;
  backdrop-filter: blur(6rpx);
}

/* 内容区 */
.act-body {
  padding: 20rpx 24rpx;
}

/* 标签行 */
.act-tags {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}
.tag-hot-icon { width: 22rpx; height: 22rpx; }
.tag-hot {
  font-size: 22rpx;
  color: #e8a838;
  font-weight: 600;
  white-space: nowrap;
  margin-left: 4rpx;
}

/* 标题行：名称 + 日期 同行 */
.act-title-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.act-title {
  flex: 1;
  min-width: 0;
  font-size: var(--text-md);
  font-weight: 700;
  color: var(--text-title);
  line-height: 1.45;
}
.act-date {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: var(--text-hint);
  white-space: nowrap;
  padding-bottom: 4rpx;
}
.sort-icon-img { width: 26rpx; height: 26rpx; }
.date-icon-img { width: 22rpx; height: 22rpx; flex-shrink: 0; }

/* 活动简介行 */
.act-desc-row {
  display: flex;
  align-items: flex-start;
  gap: 6rpx;
  margin-bottom: 14rpx;
}
.desc-icon-img { width: 22rpx; height: 22rpx; flex-shrink: 0; margin-top: 3rpx; }
.act-desc {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 信息行（位置） */
.meta-row {
  display: flex;
  align-items: center;
  font-size: var(--text-sm);
  color: var(--text-secondary);
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}
.meta-icon-img { width: 22rpx; height: 22rpx; flex-shrink: 0; }

/* 底部栏：位置 + 按钮 同行左右对齐 */
.act-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14rpx;
  gap: 16rpx;
}
.act-btn {
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-light));
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(var(--color-brand-rgb), 0.18);
}
.act-btn:active { opacity: 0.8; transform: scale(0.95); }
.act-btn-disabled {
  padding: 12rpx 32rpx;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  background: var(--border-light);
  color: var(--text-hint);
}

/* ── 区域弹窗增强 ── */
.panel-handle {
  width: 60rpx; height: 6rpx;
  background: var(--border-base);
  border-radius: 3rpx;
  margin: 16rpx auto 0;
}
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx var(--space-lg);
  border-bottom: 1rpx solid var(--border-light);
}
.panel-title {
  font-size: var(--text-lg);
  font-weight: 700;
}
.panel-close {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.5;
  padding: 8rpx;
}
.panel-body { max-height: 50vh; padding: 8rpx 0 120rpx; }
.district-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx var(--space-lg);
  font-size: var(--text-base);
  color: var(--text-body);
  transition: background var(--duration-fast);
}
.district-option:active { background: var(--bg-page); }
.district-option.option-on {
  color: var(--color-brand);
  font-weight: 600;
}
.option-check {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* ── 关键帧动画 ── */
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.85; transform: scale(1.04); }
}

/* SVG 图标替代 emoji 的兜底尺寸 */
.empty-state-icon-img { width: 160rpx; height: 160rpx; opacity: 0.35; margin-bottom: var(--space-xs); }
.back-to-top-arrow-img { width: 36rpx; height: 36rpx; }
