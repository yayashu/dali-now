.page-live-post {
  background: var(--bg-page);
  min-height: 100vh;
}

/* ============================================================
   沉浸式头部（无缝衔接版）
   ============================================================ */
.post-hero {
  position: relative;
  flex-shrink: 0;
  background: linear-gradient(165deg, var(--color-brand-dark) 0%, var(--color-brand) 45%, var(--color-brand-light) 80%, var(--color-brand-hero-end) 100%);
  padding: 0 var(--space-lg) 12rpx;
  overflow: hidden;
}

/* 底部渐淡过渡（绿→页面底色） */
.post-hero::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(to bottom, transparent, var(--bg-page));
  z-index: 0;
  pointer-events: none;
}

.post-hero .hero-pattern {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.05);
}

.post-hero .hero-pattern::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -60rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
}

/* 自定义导航行（返回+标题，融入 hero 顶部） */
.hero-nav-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  height: 88rpx;
  gap: 16rpx;
}

.nav-back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.15s;
}

.nav-back-active {
  background: rgba(255,255,255,0.3);
}

.nav-back-arrow {
  font-size: 44rpx;
  font-weight: 300;
  color: #ffffff;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

/* 副标语（紧贴标题，中间无 gap） */
.post-slogan-sub {
  display: block;
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
  margin-bottom: 32rpx;
}

/* 底部信息栏 */
.hero-bottom-bar {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

/* ===== 核验状态徽章 — 白色底高对比 ===== */
.verify-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.12);
  flex-shrink: 0;
  min-width: 156rpx;
  transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.verify-checking {
  background: rgba(255,255,255,0.65);
  backdrop-filter: blur(10rpx);
  box-shadow: none;
}

.verify-ok {
  background: #ffffff;
}

.verify-badge .verify-icon {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
}

.verify-badge text:last-child {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.verify-checking .verify-icon {
  color: var(--color-brand);
}

.verify-checking text:last-child {
  color: rgba(var(--color-brand-rgb),0.6);
}

.verify-ok .verify-icon {
  color: var(--color-brand);
}

.verify-ok text:last-child {
  color: var(--color-brand);
}

/* 核验完成 — 弹入动画 */
.verify-ok .verify-icon {
  animation: verifyPopIn 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
}

@keyframes verifyPopIn {
  0%   { transform: scale(0); opacity: 0; }
  60%  { transform: scale(1.3); }
  100% { transform: scale(1); opacity: 1; }
}

/* 核验中 — 脉冲动画 */
.verify-checking .verify-icon {
  animation: verifyPulse 1.8s ease-in-out infinite;
}

@keyframes verifyPulse {
  0%, 100% { opacity: 0.35; }
  50%      { opacity: 1; }
}

/* ===== "我在现场" 状态卡片 — 白色底 + 绿色点缀 ===== */
.post-user-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 18rpx 26rpx;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.12);
  flex: 1;
  min-width: 0;
}

.post-user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-brand);
  box-shadow: 0 0 0 6rpx rgba(var(--color-brand-rgb),0.1);
  flex-shrink: 0;
}

.post-user-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.post-user-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.user-name-pin-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.post-user-time {
  font-size: 24rpx;
  color: #999999;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.post-user-time::before {
  content: '🕐';
  font-size: 22rpx;
}

/* ============================================================
   统一内容面板（头部下方，无缝衔接）
   ============================================================ */
.post-panel {
  margin: -30rpx 0 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx 0;
  min-height: 60vh;
}

/* 极速/模板模式 */
.quick-mode,
.content-mode {
  display: flex;
  flex-direction: column;
}

/* 表单行（替代独立卡片 .form-group） */
.form-row {
  margin-bottom: 28rpx;
}

.form-row-tap {
  padding: 8rpx 0;
}

.form-row-tap:active {
  opacity: 0.6;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.form-label-tip {
  font-size: 22rpx;
  color: var(--color-brand);
  background: rgba(var(--color-brand-rgb),0.08);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 14rpx;
}

.form-value-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #333333;
}

.form-placeholder {
  color: #cccccc;
}

.form-value-wrap image {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.4;
}

.form-textarea {
  width: 100%;
  min-height: 288rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: border-color 0.2s, background 0.2s;
}

/* 聚焦态 — 绿色边框提示 */
.form-textarea:focus {
  border-color: var(--color-brand);
  background: #f0faf4;
}

.quick-textarea {
  min-height: 288rpx;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #cccccc;
  margin-top: 8rpx;
}

/* 素材上传 */
.media-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.media-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.media-img {
  width: 100%;
  height: 100%;
}

.media-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
}

.media-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #dddddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #fafafa;
}

.media-add image {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.4;
}

.media-add text {
  font-size: 22rpx;
  color: #cccccc;
}

.btn-disabled {
  opacity: 0.5;
}

/* 模板 */
.template-section {
  margin-bottom: 28rpx;
}

.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.template-scroll {
  white-space: nowrap;
}

.template-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-right: 20rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.template-item.template-selected {
  border-color: var(--color-brand);
  background: rgba(var(--color-brand-rgb),0.05);
}

.template-item image {
  width: 160rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.template-item text {
  font-size: 22rpx;
  color: #666666;
}

/* 发布按钮 */
.publish-section {
  margin-top: 16rpx;
  padding-bottom: 40rpx;
}

.publish-section .btn-accent,
.publish-section .btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
  border: none;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-light) 100%);
  box-shadow: 0 4rpx 14rpx rgba(var(--color-brand-rgb),0.25);
  transition: all 0.15s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.publish-section .btn-accent:active,
.publish-section .btn-primary:active {
  transform: scale(0.95);
  opacity: 0.85;
}
