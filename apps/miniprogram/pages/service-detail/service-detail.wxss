/* 便民服务详情页 */
.page-svc-detail { min-height:100vh; background:var(--color-bg); padding-bottom:20rpx; }

/* 加载状态 */
.loading-state { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:120rpx 0; }
.loading-spinner { width:48rpx; height:48rpx; border:4rpx solid var(--color-border); border-top-color:var(--color-brand); border-radius:50%; animation:spin 0.8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }
.loading-text { margin-top:16rpx; color:var(--color-text-secondary); font-size:26rpx; }

/* 通用 Hero */
.svc-detail-hero { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:64rpx 32rpx; margin:24rpx; border-radius:20rpx; }
.svc-detail-hero-icon { width: 96rpx; height: 96rpx; margin-bottom:12rpx; }
.svc-detail-hero-temp { font-size:72rpx; font-weight:700; color:#fff; }
.svc-detail-hero-desc { font-size:28rpx; color:rgba(255,255,255,0.85); margin-top:8rpx; }
.svc-detail-hero-title { font-size:40rpx; font-weight:700; color:#fff; }
.svc-detail-hero-sub { font-size:26rpx; color:rgba(255,255,255,0.75); margin-top:6rpx; }
.weather-hero { background:linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
.traffic-hero { background:linear-gradient(135deg, #11998e 0%, #38ef7d 100%); }
.bus-hero { background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); }

/* 详情卡片 */
.svc-detail-card { margin:0 24rpx 24rpx; background:#fff; border-radius:16rpx; padding:0 24rpx; overflow:hidden; }
.svc-detail-row { display:flex; justify-content:space-between; align-items:center; padding:24rpx 0; border-bottom:1rpx solid var(--color-border-light); }
.svc-detail-row:last-child { border-bottom:none; }
.svc-detail-label { font-size:28rpx; color:var(--color-text-secondary); }
.svc-detail-value { font-size:28rpx; font-weight:600; color:var(--color-text); }

/* 交通路况项 */
.traffic-item { display:flex; align-items:center; gap:20rpx; padding:24rpx 0; border-bottom:1rpx solid var(--color-border-light); }
.traffic-item:last-child { border-bottom:none; }
.traffic-status { padding:6rpx 18rpx; border-radius:8rpx; font-size:22rpx; font-weight:600; }
.status-green { background:rgba(39,174,96,0.1); color:#27ae60; }
.status-yellow { background:rgba(243,156,18,0.1); color:#e67e22; }
.status-red { background:rgba(231,76,60,0.1); color:#e74c3c; }
.traffic-info { flex:1; }
.traffic-road { font-size:28rpx; font-weight:600; color:var(--color-text); }
.traffic-desc { font-size:24rpx; color:var(--color-text-secondary); margin-top:4rpx; display:block; }

/* 出行线路 */
.bus-item { display:flex; align-items:center; gap:20rpx; padding:24rpx 0; border-bottom:1rpx solid var(--color-border-light); }
.bus-item:last-child { border-bottom:none; }
.bus-num { width:80rpx; height:56rpx; background:var(--color-brand); color:#fff; border-radius:10rpx; display:flex; align-items:center; justify-content:center; font-size:24rpx; font-weight:700; flex-shrink:0; }
.bus-info { flex:1; }
.bus-stations { font-size:26rpx; color:var(--color-text); }
.bus-time { font-size:22rpx; color:var(--color-text-secondary); margin-top:4rpx; display:block; }

/* 空状态复用 */
.empty-state { display:flex; flex-direction:column; align-items:center; padding:80rpx 32rpx; }
.empty-state-icon { width: 96rpx; height: 96rpx; margin-bottom:16rpx; }
.empty-state-title { font-size:28rpx; color:var(--color-text-secondary); margin-bottom:8rpx; }
.empty-state-desc { font-size:24rpx; color:var(--color-text-placeholder); }
