.page-checkin-detail {
  background: #f5f5f5;
}

/* ========== 内联 Toast（替代 wx.showToast，避免原生浮层+渲染冲突） ========== */
.inline-toast {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 999;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 36rpx;
  background: rgba(39, 174, 96, 0.95);
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.inline-toast--show {
  opacity: 1;
}

.inline-toast-icon {
  width: 28rpx;
  height: 28rpx;
}

.inline-toast text:last-child {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.detail-cover {
  position: relative;
  width: 100%;
  height: 420rpx;
}

.detail-cover-img {
  width: 100%;
  height: 100%;
}

.back-btn {
  position: absolute;
  top: 60rpx;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(0,0,0,0.45);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn image {
  width: 36rpx;
  height: 36rpx;
}

.crowd-badge {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
}

.badge-success { background: #27ae60; }
.badge-primary { background: var(--color-brand); }
.badge-warning { background: #e8a838; }
.badge-danger { background: #e74c3c; }

/* 标题卡片 */
.detail-header-card {
  margin: -30rpx 20rpx 0;
  position: relative;
  z-index: 5;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
}

.detail-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  flex: 1;
  line-height: 1.4;
}

.detail-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.detail-scenic {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.detail-scenic-icon {
  width: 28rpx; height: 28rpx;
  flex-shrink: 0;
}
.detail-scenic-text {
  font-size: 24rpx;
  color: var(--brand-green);
  background: rgba(26, 107, 75, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

/* 人气+收费 信息行 */
.detail-extra-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.detail-popularity {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 16rpx;
  background: linear-gradient(135deg, #fff8e1, #fef5e7);
  border-radius: 12rpx;
}

.detail-extra-icon {
  font-size: 24rpx;
}

.detail-extra-label {
  font-size: 22rpx;
  color: #999;
}

.detail-extra-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-left: auto;
}

.detail-charge {
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.detail-charge.charge-fee {
  background: #fff8e1;
  color: #e8a838;
}

.detail-charge.charge-free {
  background: #e8f8f0;
  color: #27ae60;
}

.charge-detail {
  font-size: 20rpx;
  font-weight: 400;
  opacity: 0.8;
}

/* 人流详情 */
.crowd-detail {
  margin-top: 8rpx;
}

.crowd-current {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.crowd-current-icon {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.crowd-current-icon.success { background: #27ae60; }
.crowd-current-icon.primary { background: var(--color-brand); }
.crowd-current-icon.warning { background: #e8a838; }
.crowd-current-icon.danger { background: #e74c3c; }

.crowd-current-tip {
  font-size: 24rpx;
  color: #999999;
}

/* 时间线 */
.crowd-timeline {
  margin-bottom: 20rpx;
}

.timeline-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.timeline-label {
  width: 60rpx;
  font-size: 22rpx;
  color: #999999;
  flex-shrink: 0;
}

.timeline-bar-wrap {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.timeline-bar {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.bar-low { width: 25%; background: #27ae60; }
.bar-mid { width: 50%; background: var(--color-brand); }
.bar-high { width: 75%; background: #e8a838; }
.bar-full { width: 100%; background: #e74c3c; }

.timeline-status {
  width: 60rpx;
  font-size: 22rpx;
  color: #666666;
  text-align: right;
  flex-shrink: 0;
}

/* 高峰提示 */
.crowd-peak-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 20rpx;
  background: #fff8e1;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #e8a838;
}

.crowd-peak-info image {
  width: 28rpx;
  height: 28rpx;
}

.crowd-advice {
  margin-left: auto;
  font-weight: 600;
}

/* 教程 */
.tutorial-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.tutorial-item:last-child {
  border-bottom: none;
}

.tutorial-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.tutorial-label image {
  width: 28rpx;
  height: 28rpx;
}

.tutorial-label text {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.tutorial-content {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.7;
  padding-left: 36rpx;
}

/* 精准指引 */
.landmark-box {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx;
  background: #f0faf4;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.landmark-box image {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.landmark-box text {
  font-size: 26rpx;
  color: var(--color-brand);
  line-height: 1.6;
  font-weight: 500;
}

.nav-actions .btn-primary {
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.nav-actions .btn-primary image {
  width: 36rpx;
  height: 36rpx;
}

/* ========== 照片标题行 ========== */
.section-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-header-row .section-title {
  margin-bottom: 0;
}
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-title);
}
.section-title-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.photo-more-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--text-sm);
  color: var(--color-brand);
  padding: 8rpx 16rpx;
  background: var(--color-brand-bg);
  border-radius: var(--radius-full);
  transition: all var(--duration-fast) var(--ease-out);
}

.photo-more-btn:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.more-arrow {
  font-size: 28rpx;
  font-weight: 700;
}

/* ========== 照片缩略图网格 3列 ========== */
.photo-mini-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.photo-mini-item {
  width: calc((100% - 20rpx) / 3);
  aspect-ratio: 1;
  border-radius: 10rpx;
  overflow: hidden;
  position: relative;
}

.photo-mini-img {
  width: 100%;
  height: 100%;
}

.photo-mini-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 10rpx 8rpx 8rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.55));
}

.photo-mini-like {
  display: flex;
  align-items: center;
  font-size: 18rpx;
  color: #fff;
}
.photo-mini-like-icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 4rpx;
}

/* 无照片 */
.no-photo {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
  gap: 12rpx;
}

.no-photo image {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.3;
}

.no-photo text {
  font-size: var(--text-base);
  color: var(--text-hint);
}

/* ========== 底部固定精准指引栏 ========== */
.bottom-guidance-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 100;
}

.guidance-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.guidance-info image {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.guidance-text {
  font-size: 26rpx;
  color: var(--color-brand);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 分享按钮（button open-type="share" 重置） */
.guidance-share-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64rpx !important;
  height: 64rpx !important;
  min-width: 64rpx !important;
  max-width: 64rpx !important;
  background: rgba(0, 0, 0, 0.06) !important;
  border-radius: 50%;
  padding: 0 !important;
  margin: 0 !important;
  margin-left: 12rpx !important;
  border: none !important;
  flex-shrink: 0;
  line-height: 1 !important;
  box-sizing: border-box;
  overflow: hidden;
  font-size: 0;
}
.guidance-share-btn::after {
  display: none !important;
  border: none !important;
  width: 0 !important;
  height: 0 !important;
}
.guidance-share-btn image {
  width: 32rpx !important;
  height: 32rpx !important;
}

.guidance-nav-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-light));
  border-radius: 40rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.guidance-nav-btn image {
  width: 32rpx;
  height: 32rpx;
}

.guidance-nav-btn text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

.guidance-checkin-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #e67e22, #f39c12);
  border-radius: 40rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.guidance-checkin-btn image {
  width: 28rpx;
  height: 28rpx;
}

.guidance-checkin-btn text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

/* image icon replacements */
.detail-extra-icon-img { width: 28rpx; height: 28rpx; flex-shrink: 0; }



