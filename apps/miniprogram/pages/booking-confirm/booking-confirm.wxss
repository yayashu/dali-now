.page-confirm {
  background: linear-gradient(180deg, var(--color-brand) 0%, #f5f5f5 40%);
  min-height: 100vh;
  padding: 40rpx 30rpx;
}

.confirm-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(var(--color-brand-rgb),0.2);
}

.success-icon image {
  width: 64rpx;
  height: 64rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.success-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 40rpx;
}

/* 电子凭证 */
.ticket-card {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.ticket-header {
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-light));
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ticket-label {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.ticket-code {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  font-family: monospace;
  letter-spacing: 2rpx;
}

.ticket-body {
  padding: 24rpx 30rpx;
}

.ticket-info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #f0f0f0;
}

.ticket-info-row:last-child {
  border-bottom: none;
}

.ticket-info-label {
  font-size: 26rpx;
  color: #999999;
}

.ticket-info-value {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.ticket-qr {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  border-top: 2rpx dashed #eeeeee;
}

.qr-placeholder {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  border: 2rpx dashed #dddddd;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #cccccc;
  font-size: 24rpx;
}

.qr-tip {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 操作按钮 */
.confirm-actions {
  width: 100%;
  margin-bottom: 30rpx;
}

.confirm-actions .btn-primary {
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
}

.confirm-actions .btn-outline {
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.confirm-actions .btn-outline image {
  width: 36rpx;
  height: 36rpx;
}

/* 提醒 */
.remind-box {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 16rpx;
  gap: 16rpx;
}

.remind-box image {
  width: 48rpx;
  height: 48rpx;
}

.remind-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.remind-title {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.remind-desc {
  font-size: 22rpx;
  color: #999999;
}
