/* ============================================================
   分享海报页面
   ============================================================ */

.page-share-poster {
  min-height: 100vh;
  background: #f0f0f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 160rpx;
}

/* ── 海报预览 ── */
.poster-preview {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 0;
  animation: posterIn 0.4s ease;
}

@keyframes posterIn {
  from { opacity: 0; transform: scale(0.9); }
  to   { opacity: 1; transform: scale(1); }
}

.poster-image {
  width: 630rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.12);
  display: block;
}

.poster-tip {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #999999;
}

/* ── 加载状态 ── */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  gap: 24rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #1a6b4b;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999999;
}

/* ── 错误状态 ── */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  gap: 20rpx;
}

.error-icon {
  width: 64rpx;
  height: 64rpx;
}

.error-text {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  padding: 0 40rpx;
}

.error-retry {
  margin-top: 20rpx;
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #1a6b4b, #2a8b5b);
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.error-retry:active {
  opacity: 0.8;
}

/* ── 底部操作栏 ── */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  line-height: 1;
  overflow: visible;
}

.action-btn::after {
  border: none;
  border-radius: 44rpx;
}

.action-save {
  background: #f5f5f5;
  color: #333333;
}

.action-save:active {
  background: #e8e8e8;
}

.action-share {
  background: linear-gradient(135deg, #1a6b4b, #2a8b5b);
  color: #ffffff;
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* ── 隐藏 Canvas ── */
.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
}

/* ── 预加载图片（全部隐藏） ── */
.preload-hide {
  position: fixed;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  left: -9999rpx;
  top: -9999rpx;
}
