.page-comm-detail {
  background: #ffffff;
  min-height: 100vh;
}

.back-btn {
  position: fixed;
  top: 60rpx;
  left: 24rpx;
  z-index: 10;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 40rpx;
  color: #fff;
  line-height: 1;
}

.detail-article {
  padding: 24rpx 30rpx;
}

.article-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.article-user {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #666666;
}

.article-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
}

.article-time {
  font-size: 24rpx;
  color: #bbbbbb;
}

.article-cover {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.article-body {
  margin-bottom: 24rpx;
}

.article-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
}

.article-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.article-stats {
  display: flex;
  gap: 40rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  font-size: 26rpx;
  color: #999999;
}
.article-stat-item {
  display: flex;
  align-items: center;
}
.article-stat-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 4rpx;
}
