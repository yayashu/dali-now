<!-- 我的现场发文 -->
<view class="container page-sub {{themeClass}}">

  <!-- 统计条 -->
  <view class="stats-bar">
    <text class="stats-bar-text">共 <text class="stats-num">{{allPosts.length}}</text> 条现场发文</text>
  </view>

  <!-- 发文列表 -->
  <view class="post-list" wx:if="{{posts.length > 0}}">
    <view class="post-card {{item.is_hidden ? 'post-hidden' : ''}}"
      wx:for="{{posts}}" wx:key="id" wx:for-item="item">

      <!-- 隐藏标记 -->
      <view class="hidden-badge" wx:if="{{item.is_hidden}}">
        <view class="hidden-badge-text"><image class="post-stat-icon" src="/images/icon-view.png" mode="aspectFit"></image> 已隐藏</view>
      </view>

      <!-- 头部 -->
      <view class="post-header">
        <view class="post-header-left">
          <text class="post-date">{{item.time || item.post_date}}</text>
          <view class="tag tag-primary" wx:if="{{item.is_verified}}"><image class="tag-check-icon" src="/images/icon-check-small.png" mode="aspectFit"></image> 已核验</view>
        </view>
          <image class="post-action-btn" catchtap="onPostAction" data-id="{{item.id}}" src="/images/icon-more.png" mode="aspectFit" style="width:32rpx;height:32rpx;"></image>
      </view>

      <!-- 内容 -->
      <view class="post-content">
        <text class="post-text">{{item.content}}</text>
      </view>

      <!-- 图片 -->
      <view class="post-media" wx:if="{{item.images.length > 0}}">
        <image wx:for="{{item.images}}" wx:for-item="img" wx:key="index" wx:if="{{index < 3}}"
          class="post-img {{item.images.length === 1 ? 'post-img-single' : ''}}"
          src="{{img}}" mode="aspectFill"
          bindtap="onPreviewImage" data-urls="{{item.images}}" data-current="{{img}}">
        </image>
        <view class="post-more-mask" wx:if="{{item.images.length > 3}}"
          catchtap="onPreviewImage" data-urls="{{item.images}}" data-current="{{item.images[2]}}">
          <text class="post-more-text">+{{item.images.length - 3}}</text>
        </view>
      </view>

      <!-- 底部信息 -->
      <view class="post-footer">
        <view class="post-location" wx:if="{{item.location}}">
          <image src="/images/icon-location-sm.png" mode="aspectFit"></image>
          <text>{{item.location}}</text>
        </view>
        <view class="post-stats">
          <view class="post-stat"><image class="post-stat-icon" src="/images/icon-heart.png" mode="aspectFit"></image> {{item.like_count || 0}}</view>
          <view class="post-stat"><image class="post-stat-icon" src="/images/icon-comment.png" mode="aspectFit"></image> {{item.comment_count || 0}}</view>
          <view class="post-stat"><image class="post-stat-icon" src="/images/icon-share-sm.png" mode="aspectFit"></image> {{item.share_count || 0}}</view>
        </view>
      </view>
    </view>
    <view class="load-more" wx:if="{{hasMore && posts.length > 0}}">上拉加载更多...</view>
    <view class="load-more" wx:elif="{{!hasMore && posts.length > 0}}">— 已加载全部 —</view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <image src="/images/empty-post.png" style="width:200rpx;height:200rpx;opacity:0.5;" mode="aspectFit"></image>
    <text class="text-light mt-20">暂无现场发文</text>
    <text class="text-light text-sm">去「我在现场」发布你的第一条动态吧</text>
  </view>

  <!-- 返回顶部 -->
  <view class="back-to-top {{showBackTop ? 'back-to-top-show' : ''}}" bindtap="onBackTop" hover-class="haptic">
    <image class="back-to-top-arrow" src="/images/icon-up.png" mode="aspectFit"></image>
  </view>

</view>
