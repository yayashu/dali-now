/* ============================================================
   我在现场 · 沉浸式交互重构 — UI/UX 优化版
   头部样式与今日活动统一（品牌绿渐变）
   ============================================================ */
.page-live {
  background: var(--bg-page);
  min-height: 100vh;
}

/* ============================================================
   沉浸式头部（与 index-hero 一致）
   ============================================================ */
.live-hero {
  position: relative;
  flex-shrink: 0;
  background: linear-gradient(165deg, var(--color-brand-dark) 0%, var(--color-brand) 45%, var(--color-brand-light) 80%, var(--color-brand-hero-end) 100%);
  padding: 0 var(--space-lg) 20rpx;
  overflow: hidden;
}

.live-hero .hero-pattern {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.05);
}

.live-hero .hero-pattern::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -60rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
}

/* 主标题 */
.live-hero .slogan-main {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
  line-height: 1.2;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
  position: relative;
  z-index: 1;
}

/* 副标题 */
.live-hero .slogan-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  letter-spacing: 1rpx;
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

/* 底部行：在线人数 + 现场发布（与 index hero-bottom 一致） */
.live-hero .hero-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 22rpx;
  position: relative;
  z-index: 1;
}

/* 在线人数标签 */
.live-hero .hero-online {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: rgba(255,255,255,0.12);
  border-radius: var(--radius-full);
  backdrop-filter: blur(4rpx);
  flex-shrink: 0;
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
}

.live-hero .hero-online:active {
  opacity: 0.8;
}

/* 在线绿点 */
.live-hero .hero-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #4eff6b;
  box-shadow: 0 0 12rpx #4eff6b;
  animation: live-dot-pulse 2s infinite;
}

@keyframes live-dot-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}

.live-hero .hero-num {
  font-size: 30rpx;
  font-weight: 800;
  color: #fff;
}

/* 现场发布按钮 */
.live-hero .hero-action {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: rgba(255,255,255,0.12);
  border-radius: var(--radius-full);
  backdrop-filter: blur(4rpx);
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.live-hero .hero-action .action-icon {
  font-size: 26rpx;
  font-weight: 300;
  line-height: 1;
}
.action-icon-img {
  width: 28rpx; height: 28rpx;
  flex-shrink: 0;
  filter: brightness(0) invert(1);
}

.live-hero .hero-action:active {
  background: rgba(255,255,255,0.24);
}

/* ============================================================
   内容主体区
   ============================================================ */
.body-area {
  position: relative;
  z-index: 5;
  padding: var(--space-md) var(--space-md) 0;
}

/* ============================================================
   搜索栏
   ============================================================ */
.toolbar {
  padding: 0 4rpx;
  margin-bottom: 12rpx;
}

/* ── 搜索栏增强 ── */
.search-box {
  display: flex;
  align-items: center;
  background: var(--bg-surface);
  border-radius: 44rpx;
  padding: 4rpx 12rpx 4rpx 16rpx;
  box-shadow: var(--shadow-sm);
  height: 76rpx;
  border: 2rpx solid transparent;
  transition: border-color var(--duration-fast);
}
.search-box:focus-within,
.search-box.focused {
  border-color: var(--color-brand);
  box-shadow: 0 0 0 6rpx rgba(var(--color-brand-rgb),0.08), var(--shadow-sm);
}

.search-icon-c {
  width: 28rpx; height: 28rpx;
  margin-right: 10rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  height: 76rpx;
  line-height: 76rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8e8e8;
  border-radius: 50%;
  flex-shrink: 0;
}

.search-clear-x {
  font-size: 22rpx;
  color: #999999;
  line-height: 1;
}
.search-clear-x-img {
  width: 22rpx; height: 22rpx;
  opacity: 0.5;
}

/* ============================================================
   搜索建议面板（聚焦搜索框时弹出）
   ============================================================ */
.search-suggest {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.1);
  padding: 8rpx 0 12rpx;
  margin-bottom: 16rpx;
  animation: suggest-in 0.2s ease;
}
@keyframes suggest-in {
  from { opacity: 0; transform: translateY(-8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.suggest-section {
  padding: 6rpx 0;
}
.suggest-section + .suggest-section {
  border-top: 1rpx solid #f0f0f0;
}

.suggest-label {
  padding: 12rpx 24rpx 6rpx;
  font-size: 22rpx;
  color: #999999;
  font-weight: 600;
}

.suggest-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  color: #333333;
}
.suggest-item:active {
  background: #fef9ee;
}

.suggest-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}
.suggest-icon-img {
  width: 28rpx; height: 28rpx;
  flex-shrink: 0;
  opacity: 0.7;
}
.live-label-icon {
  width: 28rpx; height: 28rpx;
  vertical-align: middle;
  display: inline-block;
  margin-right: 4rpx;
}

.suggest-name {
  flex: 1;
}

.suggest-dist {
  font-size: 22rpx;
  color: #aaaaaa;
  flex-shrink: 0;
}

.suggest-empty {
  padding: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #bbbbbb;
}

/* ============================================================
   排序下拉（嵌入实时现场行右端）
   ============================================================ */
.sort-picker {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: #f5f5f3;
  font-size: 24rpx;
  color: #666666;
  flex-shrink: 0;
}
.sort-picker:active {
  background: #eeece9;
}

.sort-picker-arrow {
  font-size: 20rpx;
  transition: transform 0.15s;
}
.sort-picker-arrow-img {
  width: 20rpx; height: 20rpx;
  transition: transform 0.15s;
}
.sort-arrow-up {
  transform: rotate(180deg);
}

.sort-dropdown {
  position: absolute;
  right: 0;
  top: 100%;
  margin-top: 8rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.12);
  padding: 8rpx 0;
  z-index: 10;
  min-width: 200rpx;
  animation: sort-in 0.18s ease;
}
@keyframes sort-in {
  from { opacity: 0; transform: translateY(-6rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.sort-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx;
  font-size: 26rpx;
  color: #333333;
}
.sort-option:active {
  background: #fef9ee;
}
.sort-option-on {
  color: #d4922a;
  font-weight: 600;
}

.sort-check {
  color: #d4922a;
  font-size: 24rpx;
}
.sort-check-img {
  width: 24rpx; height: 24rpx;
  flex-shrink: 0;
}

.sort-dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
}

/* ============================================================
   筛选行（紧凑双行：场地+活动+距离 | 排序+清除）
   ============================================================ */
.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0 10rpx;
}
.filter-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.filter-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

/* 筛选芯片 */
.fchip {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 22rpx;
  background: #ffffff;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666666;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  flex-shrink: 0;
  transition: all 0.15s;
}
.fchip:active { transform: scale(0.96); }
.fchip-active {
  background: rgba(var(--color-brand-rgb),0.06);
  color: var(--color-brand);
  font-weight: 600;
  border: 2rpx solid var(--color-brand);
  box-shadow: 0 2rpx 12rpx rgba(var(--color-brand-rgb),0.15);
}
.fchip-emoji {
  font-size: 22rpx;
  opacity: 0.7;
}
.fchip-sm {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
}
.fchip-sort { color: #999999; }
.fchip-arrow {
  font-size: 16rpx;
  color: #bbbbbb;
  transition: transform 0.2s;
}
.fchip-expanded .fchip-arrow {
  transform: rotate(180deg);
}
.fchip-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.fchip-clear text {
  font-size: 22rpx;
  color: #e74c3c;
  line-height: 1;
}

/* 活跃筛选标签 */
.active-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 0 0 12rpx;
}

.active-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: #e8f0fe;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #2a6b9c;
  border: 1rpx solid #c4d9f0;
}

.active-tag-x {
  font-size: 18rpx;
  color: #8ab4d0;
}

/* ============================================================
   距离/排序小弹窗（紧凑型）
   ============================================================ */
.dropdown-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 90;
  background: rgba(0,0,0,0.12);
}
.dropdown-sm {
  position: relative;
  z-index: 100;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.10);
  margin-bottom: 16rpx;
  overflow: hidden;
}
.ds-list { padding: 6rpx 0; }
.ds-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 26rpx;
  font-size: 26rpx;
  color: #333333;
}
.ds-item:active { background: #fef9ee; }
.ds-item-on {
  color: #d4922a;
  font-weight: 600;
  background: #fffaf3;
}
.ds-check {
  font-size: 22rpx;
  color: #d4922a;
  font-weight: 700;
}

/* ============================================================
   半屏选择面板（活动 / 打卡点）
   ============================================================ */
.panel-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}
.panel-mask-on {
  opacity: 1;
  pointer-events: auto;
}
.panel {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 210;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  height: 70vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}
.panel-on {
  transform: translateY(0);
}

/* 面板头部 */
.panel-hd {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 28rpx;
  position: relative;
  flex-shrink: 0;
}
.panel-handle {
  position: absolute;
  top: 12rpx;
  width: 56rpx;
  height: 6rpx;
  background: #dddddd;
  border-radius: 3rpx;
}
.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.panel-close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999999;
}

/* 面板内搜索 */
.panel-search {
  display: flex;
  align-items: center;
  margin: 0 28rpx 16rpx;
  padding: 0 20rpx;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  flex-shrink: 0;
}
.ps-icon {
  font-size: 26rpx;
  opacity: 0.5;
  margin-right: 10rpx;
}
.ps-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  height: 72rpx;
  line-height: 72rpx;
}

/* 面板列表 */
.panel-body {
  flex: 1;
  padding: 0 12rpx 20rpx;
  min-height: 0;
}
.pitem {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
  border-radius: 12rpx;
}
.pitem:active { background: #fef9ee; }
.pitem-on {
  color: #d4922a;
  font-weight: 600;
  background: #fffaf3;
}
.pitem-check {
  font-size: 24rpx;
  color: #d4922a;
  font-weight: 700;
}
.panel-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #bbbbbb;
}

/* ============================================================
   发布条
   ============================================================ */
.publish-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 44rpx;
  padding: 10rpx 12rpx 10rpx 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  height: 80rpx;
}

.publish-bar:active {
  background: #fafafa;
}

.publish-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-light) 100%);
  margin-right: 14rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.publish-avatar image {
  width: 100%;
  height: 100%;
}

.publish-placeholder {
  flex: 1;
  font-size: 26rpx;
  color: #bbbbbb;
}

.publish-btn-sm {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-light) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.publish-btn-sm text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}

/* ============================================================
   动态流
   ============================================================ */
.feed-section {
  padding-bottom: 120rpx;
}

.feed-section-hd {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.feed-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.feed-section-count {
  font-size: 22rpx;
  color: #999999;
  background: #e8e8e8;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

/* 空状态（增强版） */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  gap: 14rpx;
}
.empty-icon {
  font-size: 88rpx;
  margin-bottom: 10rpx;
  opacity: 0.7;
}
.empty-icon-img {
  width: 88rpx; height: 88rpx;
  margin-bottom: 10rpx;
  opacity: 0.5;
}
.empty-title {
  font-size: var(--text-base);
  color: var(--text-secondary);
  font-weight: 600;
}
.empty-desc {
  font-size: var(--text-sm);
  color: var(--text-hint);
}
.empty-action {
  margin-top: 18rpx;
  padding: 14rpx 40rpx;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-light) 100%);
  color: #fff;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(var(--color-brand-rgb),0.25);
}
.empty-action:active { opacity: 0.8; transform: scale(0.95); }

/* 卡片列表 */
.card-list {
  display: flex;
  flex-direction: column;
}

/* ============================================================
   单张卡片（宽度与今日活动统一：左右无 margin，由外层 padding 控制）
   ============================================================ */
.card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-xs);
  transition: transform var(--duration-fast) var(--ease-out);
  animation: fadeIn 0.35s var(--ease-out) both;
  margin: 0 0 var(--space-lg);
}
.card:active {
  transform: scale(0.985);
}

/* 卡片头部：用户信息 */
.card-hd {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.card-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.card-user {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.card-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

/* 标签单行：已核验 + 关联活动 + 关联打卡点 */
.card-tags-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 8rpx;
  overflow: hidden;
  max-width: 100%;
}

.card-tag-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
  min-width: 0;
}

.card-tag {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  padding: 3rpx 10rpx;
  border-radius: 6rpx;
  line-height: 1.4;
}
.card-tag-icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 4rpx;
}

.card-tag-verify {
  background: #e8f5e9;
  color: var(--color-brand);
  flex-shrink: 0;
}

.card-tag-activity {
  background: #fef3e6;
  color: #d4922a;
}

.card-tag-point {
  background: #e8f0fe;
  color: #2a6b9c;
}

.card-tag-dist {
  background: #fce4ec;
  color: #c62828;
}
.card-tag-icon {
  width: 22rpx; height: 22rpx;
  vertical-align: middle;
  display: inline-block;
  margin-right: 2rpx;
}

.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.card-time {
  font-size: 22rpx;
  color: #bbbbbb;
}

.card-more {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999999;
  background: #f5f5f5;
  border-radius: 10rpx;
}
.card-more-icon {
  width: 28rpx; height: 28rpx;
}

/* 卡片内容 */
.card-body {
  margin-bottom: 16rpx;
}

.card-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.7;
  word-break: break-all;
}

/* 图片网格 - 固定3列 */
.card-media {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.card-img {
  width: calc((100% - 8rpx) / 3);
  height: 220rpx;
  background: #f0f0f0;
}

.card-img-full {
  width: 100%;
  height: 380rpx;
  border-radius: 12rpx;
}

/* 第3张图上的 +N 遮罩 */
.card-more-mask {
  position: absolute;
  right: 0;
  bottom: 0;
  width: calc((100% - 8rpx) / 3);
  height: 220rpx;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 6rpx 0;
}
.card-more-text {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

/* 视频预览 */
.card-video {
  position: relative;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.card-video-bg {
  width: 100%;
  height: 380rpx;
}

.card-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

/* 卡片底部：地点 + 互动 */
.card-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f2f2;
}

.card-loc {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #aaaaaa;
}
.card-loc-icon {
  width: 24rpx; height: 24rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 36rpx;
}

.card-act {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 28rpx;
  padding: 4rpx 0;
}
.card-act-icon {
  width: 32rpx; height: 32rpx;
  flex-shrink: 0;
}

.act-num {
  font-size: 22rpx;
  color: #999999;
}

.icon-liked {
  animation: liked-pop 0.3s ease;
}

@keyframes liked-pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

/* 底部提示 */
.feed-end {
  text-align: center;
  padding: 30rpx 0;
  font-size: 22rpx;
  color: #cccccc;
}

/* ============================================================
   FAB 浮动按钮
   ============================================================ */
.fab {
  position: fixed;
  right: 30rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-light) 100%);
  box-shadow: 0 8rpx 28rpx rgba(var(--color-brand-rgb),0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  transition: transform 0.2s;
}

.fab:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 44rpx;
  color: #ffffff;
  font-weight: 200;
  line-height: 1;
}

/* ============================================================
   底部浮层 (Bottom Sheet)
   ============================================================ */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.sheet-mask-show {
  opacity: 1;
  pointer-events: auto;
}

.sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 210;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 28rpx 50rpx;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

.sheet-show {
  transform: translateY(0);
}

.sheet-bar {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

.sheet-handle {
  width: 60rpx;
  height: 6rpx;
  background: #dddddd;
  border-radius: 3rpx;
}

.sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}

.sheet-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.sheet-opt {
  display: flex;
  align-items: center;
  padding: 20rpx 20rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
}

.sheet-opt:active {
  background: rgba(var(--color-brand-rgb),0.04);
}

.sheet-opt-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.opt-flash {
  background: linear-gradient(135deg, #d4efe2, #b7e4cc);
}
.sheet-opt-icon-img {
  width: 72rpx; height: 72rpx;
  border-radius: 18rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.sheet-opt-icon-img.opt-flash {
  background: linear-gradient(135deg, #d4efe2, #b7e4cc);
}

.opt-template {
  background: linear-gradient(135deg, #cce5da, #a8d5be);
}

.sheet-opt-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sheet-opt-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.sheet-opt-desc {
  font-size: 22rpx;
  color: #999999;
}

.sheet-opt-arrow {
  font-size: 32rpx;
  color: #cccccc;
  flex-shrink: 0;
}

.sheet-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 20rpx;
  background: rgba(var(--color-brand-rgb),0.06);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.sheet-tip text {
  font-size: 22rpx;
  color: var(--color-brand);
}

.sheet-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
}

.sheet-cancel:active {
  background: #e8e8e8;
}

.sheet-cancel text {
  font-size: 28rpx;
  color: #666666;
  font-weight: 600;
}

/* ============================================================
   安全区
   ============================================================ */
.safe-bottom {
  height: 40rpx;
}
