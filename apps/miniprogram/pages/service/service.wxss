/* ============================================================
   服务页 · 文旅 + 本地生活 — 对齐首页 UI 体系
   与 index.wxss 共享相同设计语言
   ============================================================ */

/* ── 全屏布局（对齐首页 page-index） ── */
.page-service {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}

/* ============================================================
   沉浸式头部（完全对齐 index-hero）
   ============================================================ */
.svc-hero {
  position: relative;
  flex-shrink: 0;
  background: linear-gradient(165deg, var(--color-brand-dark) 0%, var(--color-brand) 45%, var(--color-brand-light) 80%, var(--color-brand-hero-end) 100%);
  padding: 0 var(--space-lg) 20rpx;
  overflow: hidden;
}

/* 装饰圆（完全复刻 hero-pattern） */
.svc-hero .hero-pattern {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.05);
}
.svc-hero .hero-pattern::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -60rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
}

/* 主标题（对齐 slogan-main） */
.svc-main {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
  line-height: 1.2;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
  position: relative;
  z-index: 1;
}

/* 副标题（对齐 slogan-sub） */
.svc-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  letter-spacing: 1rpx;
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

/* 底部操作行（对齐 hero-bottom） */
.svc-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  gap: var(--space-md);
  margin-top: 22rpx;
  position: relative;
  z-index: 1;
}

/* 天气/路况快捷入口（对齐 hero-location / hero-action） */
.svc-quick-weather,
.svc-quick-traffic {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: rgba(255,255,255,0.12);
  border-radius: var(--radius-full);
  backdrop-filter: blur(4rpx);
  flex-shrink: 0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  transition: all var(--duration-fast) var(--ease-out);
}
.svc-quick-weather:active,
.svc-quick-traffic:active {
  background: rgba(255,255,255,0.3);
  transform: scale(0.95);
}
.svc-quick-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
}

/* ============================================================
   搜索栏（完全对齐 idx-search）
   ============================================================ */
.svc-search {
  display: flex;
  align-items: center;
  background: var(--bg-surface);
  margin: var(--space-md) var(--space-lg);
  padding: 16rpx 24rpx;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-xs);
  border: 2rpx solid transparent;
  transition: border-color var(--duration-fast);
}
.svc-search:active {
  border-color: var(--color-brand);
}
.svc-search-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
  flex-shrink: 0;
}
.svc-search-text {
  flex: 1;
  font-size: var(--text-sm);
  color: var(--text-hint);
}

/* ============================================================
   分类快捷入口（完全对齐 idx-tabs）
   ============================================================ */
.svc-tabs {
  display: flex;
  padding: 0 var(--space-lg) var(--space-md);
  white-space: nowrap;
}
.svc-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  color: var(--text-secondary);
  background: var(--bg-surface);
  margin-right: 12rpx;
  flex-shrink: 0;
  transition: all var(--duration-fast) var(--ease-out);
  box-shadow: var(--shadow-xs);
}
.svc-tab.tab-on {
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-light));
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(var(--color-brand-rgb),0.22);
}
.svc-tab:active {
  transform: scale(0.95);
}
.svc-tab-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
}

/* ============================================================
   内容滚动区（对齐 idx-list）
   ============================================================ */
.svc-scroll {
  flex: 1;
  min-height: 0;   /* 关键：允许 flex 子元素缩小到内容高度以下，否则 scroll-view 会撑大到内容高度 */
  padding: 0 var(--space-md);
}

/* ============================================================
   区块
   ============================================================ */
.svc-section {
  padding-bottom: var(--space-md);
}
.svc-sec-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}
.svc-sec-title {
  display: flex;
  align-items: center;
  font-size: var(--text-md);
  font-weight: 700;
  color: var(--text-title);
}
.svc-sec-title-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}
.svc-sec-more {
  font-size: var(--text-sm);
  color: var(--color-brand);
  font-weight: 500;
  padding: 6rpx 16rpx;
  background: var(--color-brand-bg);
  border-radius: var(--radius-full);
  transition: all var(--duration-fast) var(--ease-out);
}
.svc-sec-more:active {
  opacity: 0.7;
  transform: scale(0.95);
}

/* ============================================================
   景点横向滚动卡片（对齐 act-card 视觉体系）
   ============================================================ */
.svc-scenic-scroll {
  white-space: nowrap;
  padding-bottom: 4rpx;
}
.scenic-card {
  display: inline-block;
  width: 280rpx;
  margin-right: var(--space-md);
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  box-shadow: var(--shadow-sm);
  transition: transform var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out);
}
.scenic-card:last-child {
  margin-right: 0;
}
.card-press {
  transform: scale(0.98);
  box-shadow: var(--shadow-xs);
}
.scenic-img {
  width: 280rpx;
  height: 200rpx;
  display: block;
  object-fit: cover;
  transition: transform 0.6s var(--ease-out);
}
.scenic-card:active .scenic-img {
  transform: scale(1.05);
}
.scenic-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 16rpx 16rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.55));
}
.scenic-name {
  display: block;
  font-size: var(--text-base);
  font-weight: 600;
  color: #fff;
  margin-bottom: 4rpx;
}
.scenic-desc {
  display: block;
  font-size: var(--text-2xs);
  color: rgba(255,255,255,0.65);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.scenic-tags {
  display: flex;
  gap: 6rpx;
  font-size: var(--text-2xs);
  color: rgba(255,255,255,0.8);
}

/* ============================================================
   便民服务 4 宫格
   ============================================================ */
.svc-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-md);
}
.svc-grid-item {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 0;
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xs);
  transition: all var(--duration-fast) var(--ease-out);
}
.svc-grid-item:active {
  transform: scale(0.94);
  box-shadow: var(--shadow-sm);
}
.svc-grid-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  transition: transform var(--duration-fast) var(--ease-out);
}
.svc-grid-item:active .svc-grid-icon {
  transform: scale(1.1);
}
.svc-grid-item > text:last-child {
  font-size: var(--text-xs);
  color: var(--text-secondary);
  font-weight: 500;
}

/* ============================================================
   本地生活 Tab（对齐 idx-tabs 胶囊样式）
   ============================================================ */
.svc-life-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: var(--space-md);
  white-space: nowrap;
}
.svc-life-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  color: var(--text-secondary);
  background: var(--bg-surface);
  flex-shrink: 0;
  transition: all var(--duration-fast) var(--ease-out);
  box-shadow: var(--shadow-xs);
}
.svc-life-tab-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}
.svc-life-tab.tab-on {
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-light));
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(var(--color-brand-rgb),0.22);
}
.svc-life-tab:active {
  transform: scale(0.95);
}

/* ============================================================
   本地生活列表卡片（对齐 act-card 体系）
   ============================================================ */
.life-card {
  display: flex;
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--space-lg);
  box-shadow: var(--shadow-sm);
  transition: transform var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out);
}
.life-card-img {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  display: block;
  object-fit: cover;
  transition: transform 0.6s var(--ease-out);
}
.life-card:active .life-card-img {
  transform: scale(1.05);
}
.life-card-body {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
  min-width: 0;
}
.life-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.life-card-name {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--text-title);
  flex: 1;
  margin-right: 10rpx;
  min-width: 0;
}
.life-card-rating {
  display: flex;
  align-items: center;
  gap: 2rpx;
  flex-shrink: 0;
}
.rating-star {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-right: 2rpx;
}
.rating-num {
  color: var(--text-secondary);
  font-size: var(--text-xs);
  font-weight: 500;
}
.life-card-tags {
  display: flex;
  gap: 6rpx;
  flex-wrap: wrap;
}
.life-card-price {
  font-size: var(--text-sm);
  color: var(--color-warm);
  font-weight: 600;
}
.life-card-loc {
  display: flex;
  align-items: center;
  font-size: var(--text-xs);
  color: var(--text-hint);
}
.life-card-loc-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 4rpx;
}
.life-card-desc {
  font-size: var(--text-xs);
  color: var(--text-hint);
  line-height: 1.6;
}
