.page-sub { background: #f5f5f5; min-height: 100vh; }

.fav-list {
  padding-top: 10rpx;
}

.fav-item {
  padding: 20rpx;
  gap: 16rpx;
}

.fav-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.fav-info {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  gap: 6rpx;
}

.fav-name {
  font-size: var(--font-md);
  color: var(--text-primary);
}

.fav-desc {
}

.fav-type {
  align-self: flex-start;
  margin-top: 4rpx;
}

.fav-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
}
