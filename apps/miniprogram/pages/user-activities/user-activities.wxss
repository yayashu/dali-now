.page-sub { background: #f5f5f5; min-height: 100vh; }

.sub-tabs {
  display: flex;
  background: #ffffff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sub-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.sub-tab.tab-active {
  color: var(--color-brand);
  font-weight: 600;
}

.sub-tab.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--color-brand);
  border-radius: 3rpx;
}

.activity-item {
  display: flex;
  padding: 16rpx;
  gap: 16rpx;
}

.activity-item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.activity-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.activity-item-name {
  font-size: 28rpx;
  font-weight: 600;
}

.activity-item-time {
  font-size: 24rpx;
  color: #999999;
}
