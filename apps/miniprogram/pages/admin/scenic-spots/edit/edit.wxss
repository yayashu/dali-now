.page-admin-edit {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 120rpx;
}

.edit-header {
  background: linear-gradient(135deg, #1a6b4b, #2e8b57);
  padding: 24rpx 32rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.edit-header-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.edit-back-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.edit-back {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  padding: 4rpx 8rpx;
}

.edit-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.edit-body {
  padding: 16rpx 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 16rpx;
}

.section-title-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-group.half {
  flex: 1;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.form-label.required::before {
  content: '* ';
  color: #e74c3c;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  background: #f5f7fa;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea-lg {
  min-height: 200rpx;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-value {
  color: #333;
}

.picker-placeholder {
  color: #bbb;
}

.picker-arrow {
  color: #999;
  font-size: 24rpx;
}

.form-radio-group {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.form-radio {
  padding: 12rpx 28rpx;
  background: #f5f7fa;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.form-radio.active {
  background: rgba(26,107,75,0.08);
  color: #1a6b4b;
  border-color: #1a6b4b;
  font-weight: 500;
}

/* 区域选择弹窗 */
.picker-popup {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.picker-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.4);
}

.picker-panel {
  position: relative;
  width: 100%;
  max-height: 60vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow-y: auto;
  padding: 16rpx 0;
}

.picker-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  color: #333;
}

.picker-item.active {
  color: #1a6b4b;
  background: rgba(26,107,75,0.05);
  font-weight: 500;
}

.picker-check {
  color: #1a6b4b;
  font-size: 28rpx;
}

/* 上传区域 */
.upload-area {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
}

/* 多图列表 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 180rpx;
  position: relative;
}

.image-preview {
  width: 180rpx;
  height: 180rpx;
  border-radius: 10rpx;
}

.image-desc {
  width: 100%;
  height: 48rpx;
  background: #f5f7fa;
  border-radius: 6rpx;
  margin-top: 6rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  box-sizing: border-box;
}

.image-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background: #e74c3c;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  background: #f5f7fa;
  border: 2rpx dashed #ddd;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-add-icon {
  font-size: 56rpx;
  color: #ccc;
}

/* 提交栏 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  z-index: 150;
}

.btn-block {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #1a6b4b, #2e8b57);
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}
