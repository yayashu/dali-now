.page-admin-list {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 120rpx;
}

.admin-header {
  background: linear-gradient(135deg, #1a6b4b, #2e8b57);
  padding: 24rpx 32rpx 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.admin-header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.admin-title-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.admin-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.admin-header-right {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.admin-search-btn, .admin-logout-btn {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255,255,255,0.15);
}

.admin-header-bar {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
}

.admin-search-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  color: #fff;
}

.admin-search-input::placeholder {
  color: rgba(255,255,255,0.5);
}

.admin-search-clear {
  font-size: 28rpx;
  color: #fff;
  padding: 8rpx;
}

.admin-stats {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
}

.admin-list {
  padding: 16rpx 24rpx;
}

.admin-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.admin-item-info {
  flex: 1;
  min-width: 0;
}

.admin-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  display: block;
}

.admin-item-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-bottom: 4rpx;
}

.admin-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #e8f0fe;
  color: #1a6b4b;
}
.admin-tag.tag-green {
  background: #e6f7ec;
  color: #1a6b4b;
}
.admin-tag.tag-orange {
  background: #fef3e6;
  color: #e67e22;
}
.admin-tag.tag-gray {
  background: #f0f0f0;
  color: #999;
}

.admin-loc-icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
}

.admin-item-district {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.admin-item-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.admin-btn-edit {
  font-size: 24rpx;
  color: #1a6b4b;
  padding: 8rpx 24rpx;
  border: 1rpx solid #1a6b4b;
  border-radius: 8rpx;
  text-align: center;
}

.admin-btn-del {
  font-size: 24rpx;
  color: #e74c3c;
  padding: 8rpx 24rpx;
  border: 1rpx solid #e74c3c;
  border-radius: 8rpx;
  text-align: center;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-state-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.4;
}

.empty-state-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.empty-state-desc {
  font-size: 26rpx;
  color: #999;
}

.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #999;
}

.admin-fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #1a6b4b, #2e8b57);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(26,107,75,0.4);
}

.admin-fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  margin-top: -4rpx;
}
