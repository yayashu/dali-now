/* ── 关于页 ── */
.page-about {
  background: var(--bg-page);
  min-height: 100vh;
}

/* ── 沉浸式头部 ── */
.about-hero {
  background: linear-gradient(135deg, #1a6b4b 0%, #219a63 60%, #2ecc71 100%);
  padding-bottom: 80rpx;
  position: relative;
  overflow: hidden;
}
.about-hero::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: 0;
  right: 0;
  height: 60rpx;
  background: var(--bg-page);
  border-radius: 50% 50% 0 0;
}

.hero-nav-row {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
}
.nav-back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
}
.nav-back-active {
  background: rgba(255,255,255,0.25);
}
.nav-back-arrow {
  font-size: 44rpx;
  color: #fff;
  line-height: 1;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-right: 64rpx;
}

.hero-logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 30rpx;
}
.hero-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}
.hero-app-name {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}
.hero-version {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
}

/* ── 内容面板 ── */
.about-panel {
  padding: 0 30rpx;
  position: relative;
  z-index: 1;
  margin-top: -30rpx;
}

.about-card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-xs);
  overflow: hidden;
}
.about-card.privacy-card:active,
.card-active {
  background: var(--bg-page);
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-title);
  margin-bottom: 16rpx;
}

.card-content {
  font-size: 26rpx;
  color: var(--text-body);
  line-height: 1.8;
  white-space: pre-line;
}

/* ── 隐私协议入口行 ── */
.card-row {
  display: flex;
  align-items: center;
}
.card-icon {
  font-size: 40rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.card-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.card-row-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-body);
}
.card-row-desc {
  font-size: 24rpx;
  color: var(--text-hint);
}
.card-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
  flex-shrink: 0;
}

/* ── 联系方式 ── */
.contact-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.contact-row:last-child {
  border-bottom: none;
}
.contact-label {
  font-size: 26rpx;
  color: var(--text-hint);
}
.contact-value {
  font-size: 26rpx;
  color: var(--text-body);
}

/* ── 版权 ── */
.copyright {
  display: block;
  text-align: center;
  padding: 40rpx 0;
  font-size: 22rpx;
  color: var(--text-hint);
}

/* ── 隐私协议弹窗 ── */
.privacy-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}
.privacy-modal-content {
  background: #fff;
  border-radius: var(--radius-lg);
  width: 100%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.privacy-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.privacy-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-title);
}
.privacy-modal-close {
  font-size: 36rpx;
  color: var(--text-hint);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.privacy-modal-body {
  flex: 1;
  padding: 30rpx;
  max-height: 60vh;
}
.privacy-content-text {
  font-size: 26rpx;
  color: var(--text-body);
  line-height: 1.8;
  white-space: pre-line;
}
.privacy-modal-footer {
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.privacy-close-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--bg-page);
  color: var(--text-body);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
}
.privacy-close-btn::after {
  border: none;
}
