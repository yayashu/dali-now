.page-booking {
  padding-bottom: 200rpx;
}

.booking-header {
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-light));
  padding: 40rpx 30rpx 50rpx;
}

.booking-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.booking-activity {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

/* 表单 */
.form-group {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-group:last-child {
  border-bottom: none;
}

.form-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.form-value {
  font-size: 28rpx;
}

/* 计数器 */
.counter {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.counter-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-brand);
  color: var(--color-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.counter-btn.counter-disabled {
  border-color: #e0e0e0;
  color: #cccccc;
}

.counter-value {
  font-size: 32rpx;
  font-weight: 600;
  min-width: 48rpx;
  text-align: center;
}

/* 须知 */
.notice-list {
  margin-bottom: 20rpx;
}

.notice-item {
  display: flex;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

.notice-dot {
  margin-right: 10rpx;
  color: var(--color-brand);
  font-weight: 700;
}

/* 协议 */
.agreement-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #999999;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #dddddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox-checked {
  background: var(--color-brand);
  border-color: var(--color-brand);
}

.checkbox image {
  width: 20rpx;
  height: 20rpx;
}

/* 底部固定 */
.bottom-fixed {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 16rpx 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.total-label {
  font-size: 28rpx;
  color: #333333;
}

.total-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #e8a838;
}

.bottom-fixed .btn-primary {
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 32rpx;
}
