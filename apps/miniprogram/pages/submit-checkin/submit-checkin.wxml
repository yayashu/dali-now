<!-- 发现新打卡点 -->
<view class="container page-submit">
  <!-- 头部 -->
  <view class="submit-hero page-header-brand">
    <view class="submit-hero-inner">
      <text class="submit-hero-title">发现新打卡点</text>
      <text class="submit-hero-desc">分享你发现的宝藏拍照点位</text>
    </view>
  </view>

  <!-- 表单区域 -->
  <view class="submit-form">
    <!-- 打卡点名称 -->
    <view class="form-group">
      <text class="form-label required">点位名称</text>
      <input class="form-input" placeholder="例如: 洱海海舌公园观景台" value="{{form.name}}" bindinput="onFieldInput" data-field="name" maxlength="50" />
    </view>

    <!-- 类型 -->
    <view class="form-group">
      <text class="form-label required">类型</text>
      <view class="form-radio-group">
        <view class="form-radio {{form.type==='scenic'?'active':''}}" bindtap="onTypeSelect" data-value="scenic">景点固定</view>
        <view class="form-radio {{form.type==='activity'?'active':''}}" bindtap="onTypeSelect" data-value="activity">活动专属</view>
      </view>
    </view>

    <!-- 封面图片 -->
    <view class="form-group form-group-vertical">
      <text class="form-label">封面图片</text>
      <view class="upload-area" bindtap="onChooseImage">
        <image wx:if="{{form.cover}}" class="upload-preview" src="{{form.cover}}" mode="aspectFill" />
        <view wx:else class="upload-placeholder">
          <image class="upload-icon" src="/images/icon-camera.png" mode="aspectFit"></image>
          <text class="upload-text">点击上传封面图</text>
        </view>
      </view>
    </view>

    <!-- 位置 -->
    <view class="form-group" bindtap="onChooseLocation">
      <text class="form-label required">位置</text>
      <view class="form-input form-input-tap">
        <text wx:if="{{form.location}}" class="form-value">{{form.location}}</text>
        <text wx:else class="form-placeholder">点击选择地图位置</text>
        <text class="form-arr">›</text>
      </view>
    </view>

    <!-- 描述 -->
    <view class="form-group form-group-vertical">
      <text class="form-label">点位描述</text>
      <textarea class="form-textarea" placeholder="描述这个打卡点的特色、适合的拍摄场景等..." value="{{form.description}}" bindinput="onFieldInput" data-field="description" maxlength="500" auto-height />
    </view>

    <!-- 拍摄小贴士 -->
    <view class="form-group form-group-vertical">
      <text class="form-label">拍摄小贴士</text>
      <textarea class="form-textarea" placeholder="拍摄角度、构图建议、最佳时段等..." value="{{form.tips}}" bindinput="onFieldInput" data-field="tips" maxlength="300" auto-height />
    </view>

    <!-- 最佳时间 -->
    <view class="form-group">
      <text class="form-label">最佳拍摄时间</text>
      <input class="form-input" placeholder="例如: 日落前30-60分钟" value="{{form.best_time}}" bindinput="onFieldInput" data-field="best_time" maxlength="50" />
    </view>

    <!-- 高峰时段 -->
    <view class="form-group">
      <text class="form-label">高峰时段</text>
      <input class="form-input" placeholder="例如: 09:00-16:00" value="{{form.crowd_peak}}" bindinput="onFieldInput" data-field="crowd_peak" maxlength="50" />
    </view>
  </view>

  <!-- 提示信息 -->
  <view class="submit-notice">
    <image class="notice-icon" src="/images/icon-tip.png" mode="aspectFit"></image>
    <text class="notice-text">提交后需管理员审核通过，才会在"官方打卡"中展示</text>
  </view>

  <view class="safe-bottom" style="height:120rpx;"></view>

  <!-- 提交按钮 -->
  <view class="submit-bar">
    <button class="btn-primary btn-block" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">提交审核</button>
  </view>
</view>
