/* ── 注册/登录页 ── */
.page-register {
  background: var(--bg-page);
  min-height: 100vh;
}

/* ── 沉浸式头部 ── */
.register-hero {
  background: linear-gradient(135deg, #1a6b4b 0%, #219a63 60%, #2ecc71 100%);
  padding-bottom: 80rpx;
  position: relative;
  overflow: hidden;
}
.register-hero::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: 0;
  right: 0;
  height: 60rpx;
  background: var(--bg-page);
  border-radius: 50% 50% 0 0;
}

.hero-nav-row {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
}
.nav-back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
}
.nav-back-active {
  background: rgba(255,255,255,0.25);
}
.nav-back-arrow {
  font-size: 44rpx;
  color: #fff;
  line-height: 1;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-right: 64rpx;
}

.hero-avatar-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40rpx;
}
.hero-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.35);
  background: rgba(255,255,255,0.15);
}
.hero-welcome {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}
.hero-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.65);
}

/* ── 内容面板 ── */
.register-panel {
  padding: 100rpx 8rpx 0;
  position: relative;
  z-index: 1;
  margin-top: -30rpx;
}

/* ── 隐私协议勾选 ── */
.privacy-check-card {
  background: transparent;
  border-radius: 0;
  padding: 20rpx 0;
  box-shadow: none;
  margin: 36rpx 40rpx 20rpx;
}
.privacy-check-row {
  display: flex;
  align-items: center;
  justify-content: center;
}
.privacy-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  border: 2rpx solid var(--text-hint);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
  background: transparent;
}
.privacy-checkbox.checked {
  background: var(--color-primary, #1a6b4b);
  border-color: var(--color-primary, #1a6b4b);
}
.check-mark {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}
.privacy-text {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-left: 12rpx;
}
.privacy-link {
  font-size: 26rpx;
  color: var(--color-primary, #1a6b4b);
}

/* ── 注册按钮 ── */
.register-btn {
  width: 100% !important;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--color-primary, #1a6b4b);
  color: #fff;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 700;
  border: none;
  padding: 0 !important;
  margin: 0;
  letter-spacing: 2rpx;
  display: block;
  box-sizing: border-box;
}
.register-btn::after {
  border: none;
}

.register-tip {
  display: block;
  text-align: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

/* ── 隐私协议弹窗 ── */
.privacy-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}
.privacy-modal-content {
  background: #fff;
  border-radius: var(--radius-lg);
  width: 100%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.privacy-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.privacy-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-title);
}
.privacy-modal-close {
  font-size: 36rpx;
  color: var(--text-hint);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.privacy-modal-body {
  flex: 1;
  padding: 30rpx;
  max-height: 60vh;
}
.privacy-content-text {
  font-size: 26rpx;
  color: var(--text-body);
  line-height: 1.8;
  white-space: pre-line;
}
.privacy-modal-footer {
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.privacy-agree-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--color-primary, #1a6b4b);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
}
.privacy-agree-btn::after {
  border: none;
}
