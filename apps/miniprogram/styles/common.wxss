/* ============================================================
   大理此刻 · 统一设计系统
   主题：苍山洱海，诗意大理
   目标用户：来大理旅游的年轻游客
   ============================================================ */

/* ── CSS 设计令牌 ── */
page {
  /* 主色调：苍山绿 → 洱海蓝 渐变体系 */
  --color-brand:        #1a6b4b;   /* 苍山绿 - 自然、信赖 */
  --color-brand-light:  #2d8a63;   /* 浅绿 */
  --color-brand-dark:   #0f4d35;   /* 深绿 */
  --color-brand-bg:     #e8f5ee;   /* 绿底 */

  /* 暖色点缀：洱海金 - 日落、温暖 */
  --color-warm:         #e8a838;
  --color-warm-light:   #f5c96a;
  --color-warm-bg:      #fef9f0;

  /* 辅助色：洱海蓝 - 天空、湖水 */
  --color-sky:          #4a90d9;
  --color-sky-light:    #7ab8f5;
  --color-sky-bg:       #edf6fd;

  /* 功能色 */
  --color-success:      #27ae60;
  --color-danger:       #e74c3c;
  --color-warning:      #f39c12;
  --color-info:         #5dade2;

  /* 文字层级 */
  --text-title:         #111111;
  --text-body:          #333333;
  --text-secondary:     #717171;
  --text-hint:          #aaaaaa;
  --text-disable:       #cccccc;
  --text-white:         #ffffff;
  --text-on-brand:      #ffffff;
  --text-on-warm:       #5a3a08;

  /* 背景 */
  --bg-page:            #f2f1f0;   /* 暖灰底 - 比纯白更柔和 */
  --bg-surface:         #ffffff;
  --bg-elevated:        #fafaf9;
  --bg-mask:            rgba(0,0,0,0.45);

  /* 边框 */
  --border-base:        #e8e5e0;
  --border-light:       #f0eeeb;
  --border-focus:       var(--color-brand);

  /* 阴影（更有层次感的柔和阴影） */
  --shadow-xs:          0 1rpx 4rpx rgba(0,0,0,0.04);
  --shadow-sm:          0 2rpx 10rpx rgba(0,0,0,0.05);
  --shadow-md:          0 6rpx 20rpx rgba(0,0,0,0.07);
  --shadow-lg:          0 12rpx 36rpx rgba(0,0,0,0.10);
  --shadow-xl:          0 20rpx 60rpx rgba(0,0,0,0.12);
  --shadow-float:       0 8rpx 28rpx rgba(0,0,0,0.12);

  /* 圆角 */
  --radius-xs:          6rpx;
  --radius-sm:          10rpx;
  --radius-md:          16rpx;
  --radius-lg:          24rpx;
  --radius-xl:          32rpx;
  --radius-full:        9999rpx;

  /* 间距 */
  --space-xs:           8rpx;
  --space-sm:           12rpx;
  --space-md:           16rpx;
  --space-lg:           24rpx;
  --space-xl:           32rpx;
  --space-2xl:          48rpx;

  /* 字号 */
  --text-2xs:           20rpx;
  --text-xs:            22rpx;
  --text-sm:            24rpx;
  --text-base:          28rpx;
  --text-md:            30rpx;
  --text-lg:            34rpx;
  --text-xl:            38rpx;
  --text-2xl:           44rpx;
  --text-3xl:           52rpx;

  /* 动效 */
  --ease-out:           cubic-bezier(0.25, 0.8, 0.25, 1);
  --ease-in-out:        cubic-bezier(0.42, 0, 0.58, 1);
  --ease-bounce:        cubic-bezier(0.34, 1.56, 0.64, 1);
  --duration-fast:      0.15s;
  --duration-normal:    0.25s;
  --duration-slow:      0.4s;

  /* ============ 兼容旧版变量名 ============ */
  --primary:            var(--color-brand);
  --primary-light:      var(--color-brand-light);
  --primary-dark:       var(--color-brand-dark);
  --accent:             var(--color-warm);
  --accent-light:       var(--color-warm-light);
  --danger:             var(--color-danger);
  --success:            var(--color-success);
  --warning:            var(--color-warning);
  --text-primary:       var(--text-body);
  --text-light:         var(--text-hint);
  --bg-primary:         var(--bg-page);
  --bg-white:           var(--bg-surface);
  --bg-card:            var(--bg-surface);
  --border:             var(--border-base);
  --border-light:       var(--border-light);
  --radius-round:       50%;
  --font-xs:            var(--text-xs);
  --font-sm:            var(--text-sm);
  --font-md:            var(--text-base);
  --font-lg:            var(--text-lg);
  --font-xl:            var(--text-xl);
  --font-xxl:           var(--text-2xl);

  /* 品牌色 RGB（供 rgba 动态透明度使用） */
  --color-brand-rgb:        26, 107, 75;
  --color-brand-light-rgb:  45, 138, 99;
  --color-brand-hero-end:   #3da876;

  /* 全局 */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Noto Sans SC", sans-serif;
  font-size: var(--text-base);
  color: var(--text-body);
  background-color: var(--bg-page);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ── 全局重置 ── */
view, text, image, scroll-view, swiper, swiper-item,
input, button, navigator, block {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* 基础库 3.16.x 图片渲染兼容修复 */
image {
  display: block;
  flex-shrink: 0;
}

/* ── 滚动条隐藏 ── */
::-webkit-scrollbar { display: none; width: 0; height: 0; }

/* ============================================================
   布局
   ============================================================ */
.container {
  min-height: 100vh;
  background-color: var(--bg-page);
  color: var(--text-body);
}
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ============================================================
   卡片系统（三级：默认 / 高亮 / 紧凑）
   ============================================================ */
.card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  margin: var(--space-md) var(--space-lg);
  padding: var(--space-lg);
  box-shadow: var(--shadow-sm);
  transition: transform var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out);
}
.card:active {
  transform: scale(0.985);
  box-shadow: var(--shadow-xs);
}
.card-no-margin {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--shadow-sm);
}
/* 高亮卡片 - 带品牌色顶部线条 */
.card-accent {
  composes: card from global;
  border-top: 4rpx solid var(--color-brand);
}
/* 紧凑卡片 */
.card-compact {
  background: var(--bg-surface);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  box-shadow: var(--shadow-xs);
}

/* ============================================================
   按钮系统（增强版 - 含触觉反馈适配）
   ============================================================ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  border: none;
  border-radius: var(--radius-full);
  font-weight: 500;
  text-align: center;
  transition: all var(--duration-fast) var(--ease-out);
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}
.btn:active {
  transform: scale(0.95);
  opacity: 0.85;
}

/* 主要按钮 */
.btn-primary {
  composes: btn from global;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-light) 100%);
  color: var(--text-white);
  padding: var(--space-md) 40rpx;
  font-size: var(--text-base);
  box-shadow: 0 4rpx 14rpx rgba(var(--color-brand-rgb), 0.25);
}

/* 暖色按钮 */
.btn-warm {
  composes: btn from global;
  background: linear-gradient(135deg, var(--color-warm) 0%, var(--color-warm-light) 100%);
  color: var(--text-white);
  padding: var(--space-md) 40rpx;
  font-size: var(--text-base);
  box-shadow: 0 4rpx 14rpx rgba(232,168,56,0.25);
}

/* 描边按钮 */
.btn-outline {
  composes: btn from global;
  background: transparent;
  color: var(--color-brand);
  border: 2rpx solid var(--color-brand);
  padding: calc(var(--space-md) - 2rpx) 38rpx;
  font-size: var(--text-base);
}

/* 文字按钮 */
.btn-ghost {
  composes: btn from global;
  background: transparent;
  color: var(--text-secondary);
  padding: var(--space-sm) var(--space-md);
  font-size: var(--text-sm);
}

.btn-block { width: 100%; }
.btn-sm  { padding: 10rpx 24rpx !important; font-size: var(--text-sm) !important; }
.btn-lg  { padding: 22rpx 56rpx !important; font-size: var(--text-lg) !important; }
.btn-disabled { opacity: 0.45; pointer-events: none; }

/* 旧版兼容 */
.btn-accent {
  composes: btn btn-warm from global;
}

/* ============================================================
   标签系统
   ============================================================ */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-xs);
  font-size: var(--text-xs);
  font-weight: 500;
  line-height: 1.6;
}
.tag-brand    { background: var(--color-brand-bg);  color: var(--color-brand); }
.tag-warm     { background: var(--color-warm-bg);   color: #8b6914; }
.tag-success  { background: #e8f8f0; color: var(--color-success); }
.tag-danger   { background: #fdecea; color: var(--color-danger); }
.tag-info     { background: var(--color-sky-bg);    color: var(--color-sky); }
.tag-outline  { background: transparent; border: 1rpx solid var(--border-base); color: var(--text-secondary); }

/* 旧版兼容 */
.tag-primary { composes: tag tag-brand from global; }
.tag-accent  { composes: tag tag-warm from global; }

/* ============================================================
   分割线
   ============================================================ */
.divider {
  height: 1rpx;
  background: var(--border-light);
  margin: var(--space-md) 0;
}

/* ============================================================
   文本工具
   ============================================================ */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.text-ellipsis-3 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}
.text-center   { text-align: center; }
.text-left     { text-align: left; }
.text-right    { text-align: right; }
.text-brand    { color: var(--color-brand); }
.text-warm     { color: var(--color-warm); }
.text-sky      { color: var(--color-sky); }
.text-body     { color: var(--text-body); }
.text-secondary{ color: var(--text-secondary); }
.text-hint     { color: var(--text-hint); }
.text-white    { color: var(--text-white); }
.text-xs       { font-size: var(--text-xs); }
.text-sm       { font-size: var(--text-sm); }
.text-base     { font-size: var(--text-base); }
.text-md       { font-size: var(--text-md); }
.text-lg       { font-size: var(--text-lg); }
.text-xl       { font-size: var(--text-xl); }
.text-2xl      { font-size: var(--text-2xl); }
.text-bold     { font-weight: 600; }
.text-extrabold{ font-weight: 800; }

/* 兼容 */
.text-primary  { color: var(--text-body); }
.text-light    { color: var(--text-hint); }
.text-accent   { color: var(--color-warm); }

/* ============================================================
   Flex 布局
   ============================================================ */
.flex           { display: flex; }
.flex-center    { display: flex; align-items: center; justify-content: center; }
.flex-between   { display: flex; align-items: center; justify-content: space-between; }
.flex-start     { display: flex; align-items: center; justify-content: flex-start; }
.flex-end       { display: flex; align-items: center; justify-content: flex-end; }
.flex-column    { display: flex; flex-direction: column; }
.flex-wrap      { flex-wrap: wrap; }
.flex-1         { flex: 1; }
.flex-shrink-0  { flex-shrink: 0; }

/* ============================================================
   间距
   ============================================================ */
.mt-8  { margin-top: var(--space-xs); }
.mt-12 { margin-top: var(--space-sm); }
.mt-16 { margin-top: var(--space-md); }
.mt-24 { margin-top: var(--space-lg); }
.mt-32 { margin-top: var(--space-xl); }
.mt-48 { margin-top: var(--space-2xl); }
.mb-8  { margin-bottom: var(--space-xs); }
.mb-12 { margin-bottom: var(--space-sm); }
.mb-16 { margin-bottom: var(--space-md); }
.mb-24 { margin-bottom: var(--space-lg); }
.mb-32 { margin-bottom: var(--space-xl); }
.ml-8  { margin-left: var(--space-xs); }
.mr-8  { margin-right: var(--space-xs); }
.p-16  { padding: var(--space-md); }
.p-24  { padding: var(--space-lg); }
.p-32  { padding: var(--space-xl); }
.gap-8  { gap: var(--space-xs); }
.gap-12 { gap: var(--space-sm); }
.gap-16 { gap: var(--space-md); }
.gap-24 { gap: var(--space-lg); }

/* 旧版兼容 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.mr-10 { margin-right: 10rpx; }
.p-20  { padding: 20rpx; }
.p-30  { padding: 30rpx; }

/* ============================================================
   图片
   ============================================================ */
.img-cover   { width: 100%; height: 100%; object-fit: cover; }
.img-contain { width: 100%; height: 100%; object-fit: contain; }

/* ============================================================
   状态页（空/错误/加载）
   ============================================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: var(--space-md);
}
.empty-state-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.35;
  margin-bottom: var(--space-xs);
}
.empty-state-title {
  font-size: var(--text-base);
  color: var(--text-secondary);
  font-weight: 500;
}
.empty-state-desc {
  font-size: var(--text-sm);
  color: var(--text-hint);
}
.empty-state-action {
  margin-top: var(--space-md);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx;
  color: var(--text-hint);
  font-size: var(--text-sm);
  letter-spacing: 1rpx;
}

/* ============================================================
   骨架屏
   ============================================================ */
.skeleton {
  background: linear-gradient(90deg, #f0eeeb 25%, #e8e5e0 50%, #f0eeeb 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s infinite;
  border-radius: var(--radius-sm);
}
@keyframes skeleton-shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 骨架屏 - 活动卡片 */
.skeleton-card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  margin: var(--space-md) var(--space-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.skeleton-cover {
  width: 100%;
  height: 340rpx;
}
.skeleton-line {
  height: 24rpx;
  border-radius: var(--radius-xs);
  margin-bottom: var(--space-sm);
}
.skeleton-line-sm  { width: 60%; }
.skeleton-line-md  { width: 80%; }
.skeleton-line-lg  { width: 100%; }
.skeleton-line-xs  { width: 40%; height: 20rpx; }
.skeleton-tag      { width: 100rpx; height: 32rpx; border-radius: var(--radius-xs); }
.skeleton-avatar   { width: 64rpx; height: 64rpx; border-radius: 50%; }

/* ============================================================
   渐入动画
   ============================================================ */
.fade-in {
  animation: fadeIn var(--duration-normal) var(--ease-out) both;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 延迟渐入（用于列表） */
.fade-in-1  { animation-delay: 0.05s; }
.fade-in-2  { animation-delay: 0.1s; }
.fade-in-3  { animation-delay: 0.15s; }
.fade-in-4  { animation-delay: 0.2s; }
.fade-in-5  { animation-delay: 0.25s; }
.fade-in-6  { animation-delay: 0.3s; }
.fade-in-7  { animation-delay: 0.35s; }
.fade-in-8  { animation-delay: 0.4s; }

/* 弹性弹出（弹窗等） */
.pop-in {
  animation: popIn var(--duration-normal) var(--ease-bounce) both;
}
@keyframes popIn {
  from { opacity: 0; transform: scale(0.92); }
  to   { opacity: 1; transform: scale(1); }
}

/* 脉冲动画 */
.pulse {
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%      { transform: scale(1.05); opacity: 0.8; }
}

/* ============================================================
   通用页面头部（统一各页面 Header 样式）
   ============================================================ */
.page-header {
  padding: 30rpx var(--space-lg) 40rpx;
  position: relative;
  overflow: hidden;
}
.page-header::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  pointer-events: none;
}
.page-header::before {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -20%;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
  pointer-events: none;
}
.page-header-title {
  display: block;
  font-size: var(--text-xl);
  font-weight: 700;
  color: var(--text-white);
  margin-bottom: var(--space-xs);
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
}
.page-header-desc {
  display: block;
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.7);
  position: relative;
  z-index: 1;
}

/* 品牌色头部 */
.page-header-brand {
  composes: page-header from global;
  background: linear-gradient(160deg, var(--color-brand-dark) 0%, var(--color-brand) 40%, var(--color-brand-light) 100%);
}

/* 暖色头部（现场页） */
.page-header-warm {
  composes: page-header from global;
  background: linear-gradient(160deg, #c4821a 0%, var(--color-warm) 40%, var(--color-warm-light) 100%);
}

/* ============================================================
   Tab 筛选栏（胶囊式）
   ============================================================ */
.filter-tabs {
  display: flex;
  padding: var(--space-md) var(--space-lg);
  background: var(--bg-surface);
  gap: var(--space-sm);
  overflow-x: auto;
  white-space: nowrap;
}
.filter-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  color: var(--text-secondary);
  background: var(--bg-page);
  flex-shrink: 0;
  transition: all var(--duration-fast) var(--ease-out);
}
.filter-tab-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
}
.filter-tab.active {
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-light));
  color: var(--text-white);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(var(--color-brand-rgb), 0.2);
}
.filter-tab:active { transform: scale(0.95); }

/* ============================================================
   搜索栏（圆角搜索输入框）
   ============================================================ */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--bg-page);
  border-radius: var(--radius-full);
  padding: 14rpx 24rpx;
  transition: all var(--duration-fast) var(--ease-out);
  border: 2rpx solid transparent;
}
.search-bar:active,
.search-bar.focused {
  background: var(--bg-surface);
  border-color: var(--color-brand);
  box-shadow: 0 0 0 4rpx rgba(var(--color-brand-rgb), 0.08);
}
.search-bar-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.4;
  flex-shrink: 0;
}
.search-bar-placeholder {
  color: var(--text-hint);
  font-size: var(--text-sm);
  margin-left: var(--space-sm);
}
.search-bar-input {
  flex: 1;
  font-size: var(--text-sm);
  color: var(--text-body);
  height: 40rpx;
  line-height: 40rpx;
  margin-left: var(--space-sm);
}

/* ============================================================
   FAB 浮动操作按钮
   ============================================================ */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
  z-index: 50;
  transition: transform var(--duration-fast) var(--ease-out);
}
.fab:active { transform: scale(0.9); }
.fab-brand { composes: fab from global; background: var(--color-brand); }
.fab-warm  { composes: fab from global; background: var(--color-warm); }
.fab-icon  { width: 44rpx; height: 44rpx; }

/* ============================================================
   底部操作条（通用）
   ============================================================ */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: var(--bg-surface);
  padding: var(--space-md) var(--space-lg);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.05);
  gap: var(--space-md);
  z-index: 100;
}

/* ============================================================
   蒙层（半屏弹窗通用）
   ============================================================ */
.overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 900;
  visibility: hidden;
  opacity: 0;
  transition: all var(--duration-normal) var(--ease-out);
}
.overlay.show {
  visibility: visible;
  opacity: 1;
}
.overlay-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--bg-mask);
}
.overlay-panel {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  max-height: 65vh;
  background: var(--bg-surface);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform var(--duration-normal) var(--ease-out);
}
.overlay.show .overlay-panel {
  transform: translateY(0);
}

/* ============================================================
   导航栏占位（自定义导航栏页面用）
   ============================================================ */
.nav-placeholder { height: 0; }

/* ============================================================
   返回顶部按钮
   ============================================================ */
.back-to-top {
  position: fixed;
  right: 32rpx;
  bottom: 260rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg-surface);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 49;
  opacity: 0;
  transform: scale(0.6);
  pointer-events: none;
  transition: all var(--duration-fast) var(--ease-out);
}
.back-to-top.back-to-top-show {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}
.back-to-top:active {
  transform: scale(0.88);
  background: var(--border-light);
}
.back-to-top-arrow {
  width: 36rpx; height: 36rpx;
}

/* ============================================================
   触觉反馈辅助（配合 JS 调用 wx.vibrateShort）
   ============================================================ */
.haptic:active { opacity: 0.7; }

/* ============================================================
   主题二：海洋系（洱海蓝 · 莫奈印象）
   覆盖所有品牌色相关变量，暖色/sky 色同步切换
   ============================================================ */
.theme-ocean {
  /* 品牌色：深海蓝 → 浅湖青 */
  --color-brand:            #1a6b8a;
  --color-brand-light:      #3498b5;
  --color-brand-dark:       #0f4d6a;
  --color-brand-bg:         #e6f2f8;
  --color-brand-hero-end:   #5db8cc;
  --color-brand-rgb:        26, 107, 138;
  --color-brand-light-rgb:  52, 152, 181;

  /* 暖色点缀：珊瑚橙 */
  --color-warm:             #e0896e;
  --color-warm-light:       #f0ad90;
  --color-warm-bg:          #fdf3ee;

  /* 辅助色：天空蓝 */
  --color-sky:              #5da0c8;
  --color-sky-light:        #8dc4e0;
  --color-sky-bg:           #edf5fa;

  /* ======== 兼容旧版变量 ======== */
  --primary:                var(--color-brand);
  --primary-light:          var(--color-brand-light);
  --primary-dark:           var(--color-brand-dark);
  --accent:                 var(--color-warm);
  --accent-light:           var(--color-warm-light);
}
