# ============================================================
# 大理此刻 (DaLiNow) - 环境变量配置模板
# ============================================================
# 使用: cp .env.example .env ，编辑后注入进程
#   - Linux:   ./deploy/deploy.sh 会自动 source .env
#   - PM2:     pm2 start deploy/ecosystem.config.js --env production
# ⚠️ .env 含敏感信息，已被 .gitignore 忽略，请勿提交到仓库

# ---- 数据库配置 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=dali_now

# ---- 服务端口 (Node.js:3000 / Python:5000) ----
SERVER_PORT=3000

# ---- 微信小程序配置 ----
WECHAT_APPID=your_wechat_appid_here
WECHAT_SECRET=your_wechat_secret_here

# ---- 管理员账号 (Python Flask 管理后台) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here
ADMIN_SECRET=your_admin_secret_here

# ---- API 防滥用签名密钥（小程序端与服务端必须一致） ----
API_SECRET=your_api_secret_here

# ---- 频率限制 ----
RATE_LIMIT_GENERAL=100 per minute
RATE_LIMIT_SEARCH=30 per minute

# ---- 图片上传目录 (默认 ~/dali_uploads) ----
UPLOAD_DIR=/data/dali-now/uploads
